# Server Configuration
PORT=8080
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:8080

# Stripe Checkout Configuration
# Use a test key locally and configure the live key only in the deployment environment.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Microsoft 365 / Graph API Configuration
# Used for sending contact form emails
# Create these in Azure Portal: Azure AD > App registrations > Your App
M365_CLIENT_ID=your_client_id_here
M365_TENANT_ID=your_tenant_id_here
M365_CLIENT_SECRET=your_client_secret_here
M365_SENDER_EMAIL=your_email@yourdomain.com

# Email Configuration
EMAIL_TO=your_email@yourdomain.com
